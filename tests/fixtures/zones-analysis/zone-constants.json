{
  "placeholders": [
    "192.0.2.0",
    "100::"
  ],
  "tunnel": "cfargotunnel.com",
  "cfHosted": [
    {
      "suffix": "pages.dev",
      "provider": "cloudflare-pages"
    },
    {
      "suffix": "workers.dev",
      "provider": "cloudflare-workers"
    }
