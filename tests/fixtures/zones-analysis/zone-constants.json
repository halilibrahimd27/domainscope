  "awsOrigins": [
    {
      "id": "aws-api-gateway",
      "alias": "api-gateway",
      "pattern": "(?:^|\\.)execute-api\\.[a-z0-9-]+\\.amazonaws\\.com(?:\\.cn)?$"
    },
    {
      "id": "aws-elastic-beanstalk",
      "alias": "elastic-beanstalk",
      "pattern": "(?:^|\\.)elasticbeanstalk\\.com(?:\\.cn)?$"
    },
    {
      "id": "aws-global-accelerator",
      "alias": "global-accelerator",
      "pattern": "(?:^|\\.)awsglobalaccelerator\\.com$"
    },
    {
      "id": "aws-vpc-endpoint",
      "alias": "vpc-endpoint",
      "pattern": "(?:^|\\.)vpce\\.amazonaws\\.com(?:\\.cn)?$"
    }
  ],
