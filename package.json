{
  "name": "domainscope",
  "version": "1.0.0",
  "private": true,
  "description": "DomainScope — open-source SSL & DNS toolkit: find subdomains, IPs and the servers a certificate must be installed on. Runs entirely in the browser (GitHub Pages).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/js/*.test.js\"",
    "test:py": "python3 -m unittest discover -s tests/python -v",
    "test:e2e:offline": "node tests/e2e/run-all.mjs --only shell,subdomains,zone,scan,verify,renewal,dane,pfx,chainfix,renew,estate,global,ptr,retire,carry,ip,lookup,health,workspaces,origins,domain,change,cutover,privacy,reports,portfolio,secscore,locales,explain,revocation,takeover,waivers,regwatch,dmarchistory,monitor --offline --no-shots",
    "serve": "node tests/e2e/serve.mjs 8080"
  },
  "engines": {
    "node": ">=22"
  }
}
